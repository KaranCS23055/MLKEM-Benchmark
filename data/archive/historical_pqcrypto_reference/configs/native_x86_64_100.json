{
  "environment": {
    "name": "native_windows_x86_64",
    "type": "NATIVE_SOFTWARE",
    "architecture": "x86_64",
    "notes": "Native CPython process using pqcrypto ML-KEM bindings on Windows."
  },
  "implementation": {
    "name": "pqcrypto",
    "version": "0.4.0",
    "backend": "pqcrypto native ML-KEM bindings"
  },
  "variants": ["ML-KEM-512", "ML-KEM-768", "ML-KEM-1024"],
  "operations": ["keygen", "encapsulation", "decapsulation"],
  "iterations": 100
}
